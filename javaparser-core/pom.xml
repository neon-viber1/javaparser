<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.github.javaparser</groupId>
        <artifactId>javaparser-parent</artifactId>
        <version>3.29.0-SNAPSHOT</version>
    </parent>

    <artifactId>javaparser-core</artifactId>
    <packaging>jar</packaging>
    <name>${project.groupId}:${project.artifactId}</name>
    <description>The core parser functionality. This may be all you need.</description>
    <url>https://github.com/javaparser</url>

    <licenses>
        <license>
            <name>GNU Lesser General Public License</name>
            <url>http://www.gnu.org/licenses/lgpl-3.0.html</url>
            <distribution>repo</distribution>
        </license>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>http://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
            <comments>A business-friendly OSS license</comments>
        </license>
    </licenses>

    <properties>
        <java.version>1.8</java.version>
        <jpms.moduleName>com.github.javaparser.core</jpms.moduleName>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>biz.aQute.bnd</groupId>
                <artifactId>bnd-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <!-- Pick up the manifest produced by bnd-maven-plugin's bnd-process goal (MJAR-193). -->
                        <manifestFile>${project.build.outputDirectory}/META-INF/MANIFEST.MF</manifestFile>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>com.helger.maven</groupId>
                <artifactId>ph-javacc-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>javacc</id>
                        <goals>
                            <goal>javacc</goal>
                        </goals>
                        <configuration>
                            <grammarEncoding>${project.build.sourceEncoding}</grammarEncoding>
                            <jdkVersion>${java.version}</jdkVersion>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <!--
                    JavaCC generates GeneratedJavaParserTokenManager.jjMoveNfa_0 as a single method of more than
                    8000 bytes of bytecode, which HotSpot never JIT-compiles (-XX:+DontCompileHugeMethods).
                    Split the three per-character-range loops of that method into separate methods.
                    The step is idempotent and fails the build if the generated code has an unexpected shape.
                -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>split-jjMoveNfa_0</id>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <phase>generate-sources</phase>
                        <configuration>
                            <target>
                                <property name="tokenManager" value="${project.build.directory}/generated-sources/javacc/com/github/javaparser/GeneratedJavaParserTokenManager.java"/>
                                <replaceregexp byline="false" file="${tokenManager}" flags="s" match="(private int jjMoveNfa_0\(int startState, int curPos\)\n\{\n[^{}]*   for \(;;\)\n   \{\n      if \(\+\+jjround == 0x7fffffff\)\n         ReInitRounds\(\);\n)      if \(curChar &lt; 64\)\n      \{\n(         long l = 1L &lt;&lt; curChar;\n         do\n.*?         \} while\(i != startsAt\);\n)      \}\n      else if \(curChar &lt; 128\)\n      \{\n(         long l = 1L &lt;&lt; \(curChar &amp; 077\);\n         do\n.*?         \} while\(i != startsAt\);\n)      \}\n      else\n      \{\n(         int hiByte = .*?         \} while\(i != startsAt\);\n)      \}\n(      if \(kind != 0x7fffffff\)\n.*?return curPos; \}\n   \}\n\}\n)" replace="private int jjMoveNfa_0_1(int i, int startsAt, int kind) { \2      return kind; } private int jjMoveNfa_0_2(int i, int startsAt, int kind) { \3      return kind; } private int jjMoveNfa_0_3(int i, int startsAt, int kind) { \4      return kind; } \1      if (curChar &lt; 64)          kind = jjMoveNfa_0_1(i, startsAt, kind);       else if (curChar &lt; 128)          kind = jjMoveNfa_0_2(i, startsAt, kind);       else          kind = jjMoveNfa_0_3(i, startsAt, kind); \5"/>
                                <fail message="jjMoveNfa_0 in the generated token manager could not be split: unexpected JavaCC output">
                                    <condition>
                                        <not>
                                            <resourcecontains resource="${tokenManager}" substring="private int jjMoveNfa_0_3(int i, int startsAt, int kind)"/>
                                        </not>
                                    </condition>
                                </fail>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <compilerArgs>
                        <!-- This stores method parameter names in the class file, which are used by the metamodel generator -->
                        <arg>-parameters</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>add-source</id>
                        <goals>
                            <goal>add-source</goal>
                        </goals>
                        <phase>generate-sources</phase>
                        <configuration>
                            <sources>
                                <source>src/main/javacc-support</source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>templating-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>filter-src</id>
                        <goals>
                            <goal>filter-sources</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
